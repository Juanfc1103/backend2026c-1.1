<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <h1>Gestión de <%= title %></h1>
    <% if (salas.length === 0) { %>
      <p>No hay salas registradas.</p>
    <% } else { %>
      <ul>
        <% salas.forEach(s => { %>
          <li><strong><%= s.nombre %></strong> - Capacidad: <%= s.capacidad %></li>
        <% }) %>
      </ul>
    <% } %>
    <a href="/">Volver al Inicio</a>
  </body>
</html>
